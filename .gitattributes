# Force LF line endings for shell scripts (prevents Windows CRLF breaking Linux containers)
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
