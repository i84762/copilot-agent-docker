# .env.example — copy to .env and fill in values
# Used by docker-compose.yml

# ── Required ────────────────────────────────────────────────
GH_TOKEN=ghp_your_token_here

# ── Project path (Windows absolute path) ────────────────────
PROJECT_PATH=D:\Code\my-project

# ── Task ────────────────────────────────────────────────────
# Option A: inline string
# COPILOT_TASK=Implement user authentication with JWT, write unit tests, open a PR

# Option B: path to a file inside the mounted project (container path)
# COPILOT_TASK_FILE=/workspace/TASK.md

# Option C: just create one of these files in your project root — auto-discovered:
#   TASK.md  GOALS.md  GOAL.md  MISSION.md  TODO.md  .copilot-task.md

# ── Global instructions (your GitHub repo) ──────────────────
COPILOT_INSTRUCTIONS_REPO=myuser/copilot-instructions
COPILOT_INSTRUCTIONS_FILE=copilot-instructions.md
COPILOT_INSTRUCTIONS_BRANCH=main

# ── Global instructions (host machine) ───────────────────────
# run-copilot.ps1 automatically mounts %USERPROFILE%\.copilot into the container.
# If that folder contains copilot-instructions.md it will be used (merged with repo
# instructions if both are present). Set to "false" to disable.
# COPILOT_USE_HOST_INSTRUCTIONS=true
#
# To override the source folder:
# HOST_COPILOT_HOME=C:\Users\YourName\.copilot

# ── Git identity ─────────────────────────────────────────────
GIT_USER_NAME=Copilot Agent
GIT_USER_EMAIL=copilot@example.com

# ── SDK versions (optional overrides) ────────────────────────
FLUTTER_VERSION=3.24.5
GO_VERSION=1.22.5

# ── Firebase Test Lab (optional) ─────────────────────────────
# Your Firebase / GCP project ID (find it at console.firebase.google.com)
FIREBASE_PROJECT_ID=my-firebase-project

# Option A: path to your service account JSON key on Windows
# Generate at: IAM > Service Accounts > Keys  (role: Firebase Test Lab Admin)
GCLOUD_KEY_FILE=C:\keys\firebase-sa-key.json
GOOGLE_APPLICATION_CREDENTIALS=/keys/sa-key.json

# Option B: paste the entire JSON content as a single-line string (no newlines)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Target device for Firebase Test Lab (gcloud device model spec)
# List available: gcloud firebase test android models list
FIREBASE_TEST_DEVICE=model=oriole,version=33,locale=en,orientation=portrait

# Per-test run timeout
FIREBASE_TEST_TIMEOUT=5m
