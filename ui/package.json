{
  "name": "archon",
  "version": "1.0.0",
  "description": "Archon — AI agent orchestrator for automated software development",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:browser": "node server.js",
    "dev": "nodemon server.js",
    "dev:electron": "nodemon --exec \"electron .\" --watch server.js --watch electron/",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux"
  },
  "dependencies": {
    "dockerode": "^4.0.2",
    "express": "^4.19.2",
    "ssh2": "^1.15.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
